# Copie para .env.docker e preencha antes do deploy.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Para acesso pelo dominio, use a origem completa: https://mapper.exemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_NAME=gp_mapper
DB_USER=gp_mapper
DB_PASSWORD=

# Padrao: acessivel pelo proprio servidor, para uso com proxy reverso.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000

# Conta inicial: criada somente se o username ainda nao existir.
BOOTSTRAP_SUPERUSER=True
DJANGO_SUPERUSER_USERNAME=dev
DJANGO_SUPERUSER_PASSWORD=devdev333
DJANGO_SUPERUSER_EMAIL=dev@dev.com

# Registre a mesma URL em OAuth2 > Redirects no Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback/
