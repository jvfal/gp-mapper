# Desenvolvimento: Django, PostgreSQL e Redis executados na sua maquina.
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=gp_mapper
DB_USER=gp_mapper
DB_PASSWORD=change-me-local
DB_HOST=127.0.0.1
DB_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0

DISCORD_CLIENT_ID=
GUILD_NAME=Avalon Roads
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback/

# Discord Developer Portal > Bot > Token (different from the OAuth client secret).
DISCORD_BOT_TOKEN=
# Single-container deploy: True starts notifications alongside the web server.
# Keep False when running the separate notifications service from Compose.
RUN_ROUTE_NOTIFICATIONS=False
